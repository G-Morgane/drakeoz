# Mot de passe de la page /admin (obligatoire)
NUXT_ADMIN_PASSWORD=change-moi
# Secret pour signer le cookie de session (une longue chaîne aléatoire)
NUXT_SESSION_SECRET=change-moi-aussi

# Supabase, sources des matinales (prod). Laisser vide en dev : les données vont dans ./.data/db.json
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=
SUPABASE_SECRET_KEY=

# Supabase, comptes joueurs et jeu de cartes (module @nuxtjs/supabase, lit ces trois noms au démarrage)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
NUXT_SUPABASE_SECRET_KEY=

# Page /actu : le fil des réseaux
# ID de la chaîne YouTube (commence par UC..., visible dans l'URL ou les paramètres avancés de la chaîne)
NUXT_PUBLIC_YOUTUBE_CHANNEL_ID=
# Compte X sans le @
NUXT_PUBLIC_X_HANDLE=
# Compte Bluesky
NUXT_PUBLIC_BLUESKY_HANDLE=
# App Twitch (dev.twitch.tv/console, gratuite) pour lister les dernières VOD
NUXT_TWITCH_CLIENT_ID=
NUXT_TWITCH_CLIENT_SECRET=

# Connexion Twitch directe : passer à true une fois le fournisseur Twitch activé dans Supabase (Authentication, Providers)
NUXT_PUBLIC_TWITCH_AUTH=false
